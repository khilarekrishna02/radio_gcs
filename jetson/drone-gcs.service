[Unit]
Description=Drone 1 radio bridge, Pixhawk and vision (single process)
After=network.target

[Service]
Type=simple
User=jetson-arsc
SupplementaryGroups=dialout video plugdev
WorkingDirectory=/home/jetson-arsc/radio_gcs/rpi
# Prefer the stable names from: ls -l /dev/serial/by-id/
Environment=GCS_RADIO_PORT=/dev/ttyUSB0
Environment=GCS_RADIO_BAUD=57600
Environment=PIXHAWK_PORT=/dev/ttyACM0
Environment=PIXHAWK_BAUD=115200
Environment=PYTHONUNBUFFERED=1
# Use the same interpreter as in a working manual run (check: which python)
ExecStart=/usr/bin/python3 flask_app.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
